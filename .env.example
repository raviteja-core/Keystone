# Keystone Environment Configuration Template
KEYSTONE_ENV=dev
KEYSTONE_ISSUER=http://localhost:8080
KEYSTONE_COOKIE_SECURE=false
KEYSTONE_POSTGRES_PORT=54320

# 32-byte base64 master key (generate with `make dev-secrets`)
KEYSTONE_MASTER_KEY=47DEQpj8HBSa+/TImW+5JCeuQeRkm5NMpJWZG3hSuFU=

# Database Connections
KEYSTONE_AUTH_DB_URL=postgres://keystone_auth_app:auth_dev_password@postgres:5432/keystone_auth?sslmode=disable
KEYSTONE_AUTHZ_DB_URL=postgres://keystone_authz_app:authz_dev_password@postgres:5432/keystone_authz?sslmode=disable
